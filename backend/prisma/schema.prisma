generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  files               File[]
  folders             Folder[]
  uploadSessions      UploadSession[]
  receivedPermissions FilePermission[] @relation("ReceivedPermissions")
  grantedPermissions  FilePermission[] @relation("GrantedPermissions")
}

model File {
  id           String   @id @default(uuid())

  originalName String
  storedName   String
  mimeType     String
  size         Int
  storageKey   String

  isStarred    Boolean  @default(false)
  isTrashed    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  permissions  FilePermission[]
  uploadSession UploadSession?

  @@index([ownerId])
  @@index([folderId])
}

model Folder {
  id        String   @id @default(uuid())
  name      String

  isStarred Boolean  @default(false)
  isTrashed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")

  files          File[]
  uploadSessions UploadSession[]

  @@index([ownerId])
  @@index([parentId])
}

enum Permission {
  VIEWER
  EDITOR
}

model FilePermission {
  id         String     @id @default(uuid())
  fileId     String
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("ReceivedPermissions", fields: [userId], references: [id], onDelete: Cascade)
  sharedById String
  sharedBy   User       @relation("GrantedPermissions", fields: [sharedById], references: [id], onDelete: Cascade)
  permission Permission @default(VIEWER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([fileId, userId])
  @@index([fileId])
  @@index([userId])
  @@index([sharedById])
}

model UploadSession {
  id             String   @id @default(uuid())

  originalName   String
  mimeType       String
  totalSize      Int
  chunkSize      Int
  totalChunks    Int

  idempotencyKey String?
  checksum       String?

  status         UploadStatus @default(INITIATED)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId        String
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  folderId     String?
  folder       Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  fileId       String?  @unique
  file         File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  chunks       FileChunk[]

  @@index([ownerId])
  @@index([folderId])
}

model FileChunk {
  id              String   @id @default(uuid())
  chunkNumber     Int
  size            Int
  path            String
  uploadedAt      DateTime @default(now())

  uploadSessionId String
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, chunkNumber])
}

enum UploadStatus {
  INITIATED
  UPLOADING
  COMPLETED
  FAILED
}